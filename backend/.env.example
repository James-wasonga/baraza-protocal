# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Chain ---
# ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/<your-alchemy-key>
CHAIN_ID=421614
# Private key for the backend's relayer wallet. This wallet holds the
# RELAYER_ROLE on DisputeEscrow (confirms M-Pesa bonds on-chain) and the
# ARBITER_ADMIN_ROLE (commits/reveals jury seeds). NEVER commit a real key —
# fund it with only what's needed for gas.
RELAYER_PRIVATE_KEY=

# Paste these from contracts-solidity/deployments/<network>.json after running
# `npm run deploy:sepolia` in contracts-solidity/
DISPUTE_ESCROW_ADDRESS=
BARAZA_REGISTRY_ADDRESS=
REPUTATION_SBT_ADDRESS=
JURY_SELECTOR_ADDRESS=

# --- M-Pesa Daraja (Safaricom sandbox) ---
# https://developer.safaricom.co.ke — register an app to get these.
# Leave MOCK_MPESA=true to run the full flow with simulated payments and no
# real Safaricom credentials, for local development and demos.
MOCK_MPESA=true
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-ngrok-or-deployed-url.example.com/api/mpesa/callback

# --- Misc ---
# USD/KES-equivalent conversion used only to translate an ETH-denominated
# bond into an M-Pesa STK Push amount for the demo. Replace with a real
# price oracle before anything resembling production use.
ETH_TO_KES_RATE=450000
