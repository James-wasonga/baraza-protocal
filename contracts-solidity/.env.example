# Wallet that deploys the contracts and pays gas. Fund it with Arbitrum
# Sepolia test ETH first: https://faucet.quicknode.com/arbitrum/sepolia
DEPLOYER_PRIVATE_KEY=

# Optional: the address that receives RELAYER_ROLE + ARBITER_ADMIN_ROLE on
# DisputeEscrow after deploy. Leave blank to grant both to the deployer
# address itself (fine for local testing; use your backend's relayer
# wallet address here once you have one).
RELAYER_ADDRESS=

# Optional: address of an already-deployed Stylus jury-selector contract.
# Leave blank and the deploy script deploys MockJurySelector instead, so
# the system is fully wired and testable before the real Stylus contract
# exists.
STYLUS_JURY_SELECTOR_ADDRESS=

# Optional overrides — defaults already point at Arbitrum's public RPCs.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Optional: for `npm run verify:sepolia` (contract source verification on Arbiscan)
ARBISCAN_API_KEY=

REPORT_GAS=false