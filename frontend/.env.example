# Leave these blank to run the frontend in demo mode (sample data, simulated
# filing/voting) — useful for judges/reviewers browsing without a wallet or
# deployed contracts. Fill them in after `npm run deploy:sepolia` in
# contracts-solidity/ (see contracts-solidity/deployments/<network>.json).

VITE_DISPUTE_ESCROW_ADDRESS=
VITE_BARAZA_REGISTRY_ADDRESS=
VITE_REPUTATION_SBT_ADDRESS=
VITE_JURY_SELECTOR_ADDRESS=

# Backend API (for M-Pesa STK push and any indexed read endpoints)
VITE_API_BASE_URL=http://localhost:4000/api
